{
  "name": "@funberry/mobile",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "echo \"Mobile release builds use EAS or scripts/build-release-apk.sh; see docs/MOBILE_RELEASE.md\"",
    "build:apk": "bash scripts/build-release-apk.sh",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "doctor": "expo-doctor",
    "check:static": "node scripts/check-static.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:static"
  },
  "dependencies": {
    "@funberry/brand": "*",
    "@funberry/config": "*",
    "@funberry/game-engine": "*",
    "@funberry/supabase": "*",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-native": "~0.76.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "~15.8.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.0",
    "expo-doctor": "^1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.0"
  }
}
