# Copy to .env.local (never commit secrets)
# Accounts, coupons, admin, and Razorpay subscriptions run on the Cloudflare worker.
# The browser does not need a Razorpay key. The worker returns the key id at checkout.

NEXT_PUBLIC_SITE_URL=https://funberrykids.in
NEXT_PUBLIC_FUNBERRY_API=https://funberry-api.fkhambaty.workers.dev
