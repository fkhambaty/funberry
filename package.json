{
  "name": "funberrykids",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@funberry/web",
    "dev:mobile": "turbo dev --filter=@funberry/mobile",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "typecheck:tools": "tsc --noEmit -p scripts/tsconfig.json",
    "test:lesson-gen": "tsx --test packages/game-engine/src/lesson/rulesEngine.test.ts packages/game-engine/src/lesson/evidenceGate.test.ts packages/game-engine/src/games/evs/computers.test.ts packages/game-engine/src/core/contrast.test.ts packages/game-engine/src/core/access.test.ts packages/game-engine/src/embed/bridge.test.ts",
    "test:worker": "node --test cloudflare/worker/src/payments.test.js cloudflare/worker/src/integrity.test.js cloudflare/worker/src/playTickets.test.js",
    "test:mobile": "npm run test --workspace=@funberry/mobile",
    "check:mobile": "npm run check --workspace=@funberry/mobile",
    "test:responsive": "playwright test",
    "test:responsive:public": "playwright test --config=playwright.public.config.ts",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "eval:packs": "tsx scripts/eval-learning-packs.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.64.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^8.0.1",
    "eslint-config-next": "^15.5.27",
    "tesseract.js": "^5.1.1",
    "tsx": "^4.23.12",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20"
  }
}
